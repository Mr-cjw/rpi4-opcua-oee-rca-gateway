[Unit]
Description=RPi4 OPC UA Process Context, OEE and RCA Gateway
Documentation=file:/opt/rpi4-opcua-oee-rca-gateway/current/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rpi4-gateway
Group=rpi4-gateway
WorkingDirectory=/opt/rpi4-opcua-oee-rca-gateway/current
EnvironmentFile=/etc/rpi4-gateway.env
ExecStart=/usr/bin/node src/gateway/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
StateDirectory=rpi4-gateway
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
CapabilityBoundingSet=
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
