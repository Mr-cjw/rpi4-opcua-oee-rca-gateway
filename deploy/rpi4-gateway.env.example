# Copy to /etc/rpi4-gateway.env, chmod 0600, and replace placeholders.
NODE_ENV=production

# Production template uses a secured real-PLC endpoint. For isolated Mock PLC
# tests only, set both values to None and explicitly opt in below.
OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840/UA/MockPLC
OPCUA_SECURITY_MODE=SignAndEncrypt
OPCUA_SECURITY_POLICY=Basic256Sha256
OPCUA_CLIENT_PKI_ROOT=/var/lib/rpi4-gateway/pki
OPCUA_TRUST_UNKNOWN_CERTIFICATES=false
# OPCUA_CLIENT_CERTIFICATE_FILE=/etc/rpi4-gateway/opcua-client-cert.pem
# OPCUA_CLIENT_PRIVATE_KEY_FILE=/etc/rpi4-gateway/opcua-client-key.pem
# Prefer 0600 credential files over inline secrets in this environment file.
# OPCUA_USERNAME_FILE=/etc/rpi4-gateway/opcua-user
# OPCUA_PASSWORD_FILE=/etc/rpi4-gateway/opcua-password
# NODE_ENV=production rejects None security or unknown-certificate auto-trust
# unless this override is set explicitly.
GATEWAY_ALLOW_INSECURE_OPCUA=false

# Read-only PLC point mapping. Set optional sources to "off" when absent.
OPCUA_DEVICE_STATUS_NODE=ns=1;s=MockPLC.DeviceStatus
OPCUA_CURRENT_OUTPUT_NODE=ns=1;s=MockPLC.CurrentOutput
OPCUA_GOOD_COUNT_NODE=ns=1;s=MockPLC.GoodCount
OPCUA_TOTAL_PRODUCED_NODE=ns=1;s=MockPLC.TotalProducedCount
OPCUA_TEMPERATURE_NODE=ns=1;s=MockPLC.TemperatureSensor
OPCUA_ALARM_EVENTS_NODE=ns=1;s=MockPLC.AlarmEvents
OPCUA_EVENT_NODE=ns=1;s=MockPLC

# Joint-context identity used by OEE/RCA and quality-event matching.
GATEWAY_LINE_ID=JX-LINE-01
GATEWAY_STATION_ID=JX-LINQIN-STATION-01
GATEWAY_WORK_ORDER_ID=
GATEWAY_SERIAL_NUMBER=
GATEWAY_CORRELATION_ID=
GATEWAY_PRODUCT_ID=
# Runtime updates survive restarts; use off to keep them in memory only.
GATEWAY_WORK_CONTEXT_FILE=/var/lib/rpi4-gateway/work-context.json

# Local API. Keep loopback-bound and set a strong token.
GATEWAY_HTTP_HOST=127.0.0.1
GATEWAY_HTTP_PORT=8080
GATEWAY_API_TOKEN=replace-with-strong-token

# Storage pressure and write-health monitoring for the state volume.
GATEWAY_STORAGE_DISK_PATH=/var/lib/rpi4-gateway
GATEWAY_STORAGE_WARN_FREE_BYTES=104857600
GATEWAY_STORAGE_CRITICAL_FREE_BYTES=33554432
GATEWAY_STORAGE_CHECK_INTERVAL_MS=60000

# OPC UA commissioning checks: npm run doctor -- [--json] [--strict]
# Sample twice to verify counters do not decrease; warn on clock/stale timestamps.
GATEWAY_DOCTOR_SAMPLE_MS=3000
GATEWAY_DOCTOR_TIMEOUT_MS=15000
GATEWAY_DOCTOR_CLOCK_SKEW_WARNING_MS=30000
GATEWAY_DOCTOR_STALE_WARNING_MS=300000

# Live PLC diagnostics exposed through /healthz and Prometheus.
GATEWAY_PLC_STALE_WARNING_MS=300000
GATEWAY_PLC_CLOCK_SKEW_WARNING_MS=30000
OPCUA_DATA_CHANGE_TRIGGER=StatusValueTimestamp

# Durable local JSONL replay logs.
PROCESS_CONTEXT_LOG=/var/lib/rpi4-gateway/process-context.jsonl
QUALITY_EVENT_LOG=/var/lib/rpi4-gateway/quality-events.jsonl
QUALITY_EVENT_IDEMPOTENCY_FILE=/var/lib/rpi4-gateway/quality-idempotency.json
# RETENTION_MS must be >= QUALITY_EVENT_RETENTION_MS; MAX_ENTRIES >= QUALITY_EVENT_MAX_EVENTS.
QUALITY_EVENT_IDEMPOTENCY_RETENTION_MS=604800000
QUALITY_EVENT_IDEMPOTENCY_MAX_ENTRIES=100000
# Bound disk use: (MAX_FILES + 1) x MAX_BYTES per log stream.
PROCESS_CONTEXT_LOG_FSYNC=false
PROCESS_CONTEXT_LOG_MAX_BYTES=10485760
PROCESS_CONTEXT_LOG_MAX_FILES=3
QUALITY_EVENT_LOG_FSYNC=true
QUALITY_EVENT_LOG_MAX_BYTES=10485760
QUALITY_EVENT_LOG_MAX_FILES=3
PROCESS_CONTEXT_SAMPLE_INTERVAL_MS=1000
PROCESS_CONTEXT_RETENTION_MS=3600000
PROCESS_CONTEXT_MAX_EVENTS=10000
QUALITY_EVENT_RETENTION_MS=3600000
QUALITY_EVENT_MAX_EVENTS=10000

# OEE/RCA assumptions. Replace with the station's validated capacity.
OEE_NOMINAL_OUTPUT_PER_MIN=120
# Optional ideal cycle time in milliseconds; overrides the nominal rate when set.
OEE_IDEAL_CYCLE_TIME_MS=
# Optional per-product cycle times in milliseconds: PRODUCT_ID=MILLISECONDS,...
OEE_PRODUCT_CYCLE_TIMES=
# Daily local-time shift windows: [DAYS:]HH:MM-HH:MM separated by semicolons.
# Days default to every day. The default below preserves 24-hour planned time.
OEE_TIMEZONE=Asia/Shanghai
OEE_SHIFT_WINDOWS=00:00-24:00
# Optional comma-separated active alarm codes for classified stops.
OEE_PLANNED_DOWNTIME_ALARM_CODES=
OEE_CHANGEOVER_ALARM_CODES=
OEE_WINDOW_MS=300000
RCA_WINDOW_MS=300000
RCA_TEMPERATURE_THRESHOLD_C=70
