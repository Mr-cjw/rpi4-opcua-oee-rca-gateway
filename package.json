{
  "name": "rpi4-opcua-mock-plc",
  "version": "1.0.0",
  "private": true,
  "description": "OPC UA mock PLC plus process-context, OEE and RCA gateway for Raspberry Pi end-to-end testing",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "check:contracts": "node scripts/check-contracts.js",
    "check:docs": "node scripts/check-docs.js",
    "smoke": "node scripts/smoke-test.js",
    "doctor": "node scripts/gateway-doctor.js",
    "state:backup": "node scripts/gateway-state.js backup",
    "state:verify": "node scripts/gateway-state.js verify",
    "state:restore": "node scripts/gateway-state.js restore",
    "e2e": "node scripts/run-e2e.js",
    "e2e:gateway": "node scripts/gateway-e2e.js",
    "soak": "node scripts/soak.js",
    "gateway": "node src/gateway/index.js"
  },
  "dependencies": {
    "node-opcua": "2.160.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
