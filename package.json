{
  "name": "rpi4-opcua-mock-plc",
  "version": "1.0.0",
  "private": true,
  "description": "OPC UA mock PLC plus process-context, OEE and RCA gateway for Raspberry Pi end-to-end testing",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "check:contracts": "node scripts/check-contracts.js",
    "check:docs": "node scripts/check-docs.js",
    "smoke": "node scripts/smoke-test.js",
    "doctor": "node scripts/gateway-doctor.js",
    "commission": "node scripts/gateway-commission.js",
    "hardware:check": "node scripts/gateway-hardware-check.js",
    "field:drill": "node scripts/gateway-field-drill.js",
    "state:backup": "node scripts/gateway-state.js backup",
    "state:verify": "node scripts/gateway-state.js verify",
    "state:restore": "node scripts/gateway-state.js restore",
    "release:package": "node scripts/gateway-release.js package",
    "release:verify": "node scripts/gateway-release.js verify",
    "release:sign": "node scripts/gateway-release.js sign",
    "release:verify-signature": "node scripts/gateway-release.js verify-signature",
    "release:sbom": "node scripts/gateway-release.js sbom",
    "release:audit": "node scripts/gateway-release.js audit",
    "release:evidence": "node scripts/gateway-release.js evidence",
    "release:verify-evidence": "node scripts/gateway-release.js verify-evidence",
    "release:rehearse": "node scripts/gateway-release.js rehearse",
    "release:install": "node scripts/gateway-release.js install",
    "release:rollback": "node scripts/gateway-release.js rollback",
    "release:status": "node scripts/gateway-release.js status",
    "storage:evaluate": "node scripts/evaluate-storage.js",
    "edge:verify": "node scripts/gateway-edge-verify.js",
    "e2e": "node scripts/run-e2e.js",
    "e2e:gateway": "node scripts/gateway-e2e.js",
    "e2e:diagnostics": "node scripts/gateway-diagnostics-e2e.js",
    "e2e:security": "node scripts/gateway-security-e2e.js",
    "e2e:clock": "node scripts/gateway-clock-e2e.js",
    "soak": "node scripts/soak.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "gateway": "node src/gateway/index.js"
  },
  "dependencies": {
    "node-opcua": "2.188.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
