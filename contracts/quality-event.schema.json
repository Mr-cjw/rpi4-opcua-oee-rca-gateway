{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpi4.local/contracts/quality-event.schema.json",
  "title": "QualityEvent",
  "description": "NG quality event accepted by the Raspberry Pi gateway for OEE quality input and RCA targeting. The gateway stores analysis input only; it is not the MES delivery authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "qualityEventId",
    "sourceEventId",
    "eventType",
    "result",
    "occurredAt",
    "lineId",
    "stationId",
    "quantity",
    "recordedAt",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "qualityEventId": {
      "type": "string",
      "minLength": 1
    },
    "sourceEventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "const": "NG"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lineId": {
      "type": "string",
      "minLength": 1
    },
    "stationId": {
      "type": "string",
      "minLength": 1
    },
    "workOrderId": {
      "type": "string",
      "minLength": 1
    },
    "serialNumber": {
      "type": "string",
      "minLength": 1
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "defectType": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "imageId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
